# Async asyncpg connection URL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/swipe

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Auth (dev-stub mode until Firebase is wired). Comma-separated admin emails.
ADMIN_EMAILS=admin@example.com
# Local Firebase Admin JSON credentials. In Cloud Run this is ignored; use ADC instead.
# FIREBASE_ADMIN_CREDENTIALS_PATH=./firebase-service-account.json

# External services (placeholders, wired later)
# ANTHROPIC_API_KEY=
# GIS_API_KEY=
